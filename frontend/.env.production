# Production Environment Configuration
# This file is used during `npm run build`

# Backend API URL - Set this to your DigitalOcean Backend URL
# Example: https://nlviz-backend-xxxxx.ondigitalocean.app
VITE_API_BASE_URL=

# Frontend URL (used for redirects)
VITE_FRONTEND_URL=

# Allowed hosts for Vite dev server (comma-separated)
# Example: nlviz-frontend-s2jig.ondigitalocean.app,localhost
VITE_ALLOWED_HOSTS=
